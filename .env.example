# Copy this file to .env on the machine that runs server.js.
# Never commit the real .env file or send API keys in chat.
NODE_ENV=development
PORT=5001
BACKEND_URL=http://localhost:5001
FRONTEND_URL=http://localhost:5173/v4-update-/
ALLOWED_ORIGINS=http://localhost:5173
AUTH_DATABASE_PATH=data/auth.db
PASSWORD_RESET_EXPIRY_MINUTES=30
AUTH_SESSION_EXPIRY_HOURS=12
AI_REQUEST_TIMEOUT_MS=45000

BREVO_API_KEY=replace_with_a_rotated_brevo_api_key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=ShieldX

# Configure at least one AI provider on the backend only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Build-time frontend setting. Use an HTTPS public API URL in production.
VITE_API_BASE_URL=http://localhost:5001
# Optional development-only override when port 5001 is already occupied.
VITE_DEV_API_TARGET=http://localhost:5001
